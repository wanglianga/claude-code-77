# ---------- 基础配置 ----------
# compose 项目名（并行任务隔离，由环境固定，勿随意修改）
COMPOSE_PROJECT_NAME=task2026-09-1577
# 前端发布到宿主的端口（验证环境通过环境变量注入）
CC_PUBLISH_PORT=3077

# ---------- 数据库 ----------
POSTGRES_DB=elevator_rescue
POSTGRES_USER=postgres
POSTGRES_PASSWORD=elevator-secret-2026

# ---------- 后端 ----------
# JWT 签名密钥，生产环境务必更换（至少 32 个字符）
JWT_SECRET=elevator-rescue-jwt-secret-please-change-0123456789
